# Website authentication. Keep OAuth values server-side.
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=generate-a-long-random-secret
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

# Self-hosted customers, catalogue, inventory, carts, addresses, and orders.
# Local development defaults to file:.data/padma.db.
# Production should use a durable libSQL/Turso database and token.
CUSTOMER_DATABASE_URL=file:.data/padma.db
CUSTOMER_DATABASE_AUTH_TOKEN=
COMMERCE_DATABASE_URL=file:.data/padma.db
COMMERCE_DATABASE_AUTH_TOKEN=

# Comma-separated authenticated emails allowed to open /admin and admin APIs.
ADMIN_EMAILS=owner@example.com

# Durable product-image uploads. Vercel supplies this when a Blob store is connected.
BLOB_READ_WRITE_TOKEN=replace-with-vercel-blob-token

# Public base URL used for metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
